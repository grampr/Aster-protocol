{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aster.dev/gateway/v1/events/messages/message-update.schema.json",
  "title": "MessageUpdateEvent",
  "description": "Serverが購読中のClientまたはBotへ、更新後のMessage全体を配信します。",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "t", "s", "d"],
  "properties": {
    "op": { "$ref": "../../common/opcode.schema.json#/$defs/DISPATCH" },
    "t": { "$ref": "../../common/event-name.schema.json#/$defs/MESSAGE_UPDATE" },
    "s": { "type": "integer", "minimum": 0, "description": "Gateway Session内で単調増加するEvent Sequenceです。" },
    "d": { "$ref": "../../resources/message.schema.json" }
  }
}
