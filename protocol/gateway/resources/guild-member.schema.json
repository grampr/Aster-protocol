{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aster.dev/gateway/v1/resources/guild-member.schema.json",
  "title": "GatewayGuildMember",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guild_id",
    "user",
    "nickname",
    "role_ids",
    "joined_at",
    "presence"
  ],
  "properties": {
    "guild_id": {
      "type": "string",
      "format": "uuid"
    },
    "user": {
      "$ref": "./user-summary.schema.json"
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "role_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "presence": {
      "$ref": "./presence.schema.json"
    }
  }
}
